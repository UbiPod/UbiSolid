# Public URL of the pod server (NPM proxies it to ubisolid-css:3000).
CSS_BASE_URL=https://pod.example/
INVITES_ADMIN_WEBIDS=https://pod.example/you/profile/card#me

# Shared secret between CSS and the broker: openssl rand -base64 36
BROKER_SERVICE_KEY=
# Must be exactly what is registered with each provider.
BROKER_REDIRECT_URI=https://pod.example/.account/storage/callback/

# Key wrapping. Production: a Cloud KMS key the broker's service account alone may use.
# BROKER_KMS_KEY=projects/P/locations/L/keyRings/R/cryptoKeys/K
# Otherwise a local 32-byte key: openssl rand -base64 32 > master.key, keep it off backups of broker-data.
BROKER_MASTER_KEY=

# Providers: set the ones you have registered.
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
# common, consumers, organizations or a tenant ID
ONEDRIVE_TENANT=common
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
